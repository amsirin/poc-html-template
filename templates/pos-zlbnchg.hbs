{{! POS_ZLBNCHG — แจ้งผลการเปลี่ยนแปลงแก้ไขกรมธรรม์ประกันภัย
    Baseline: baselines/pos-zlbnchg.pdf (from Exstream Letter output)
    Data schema: data-samples/pos-zlbnchg.sample.json
    DXF source: ../DXF/APP_LTPOSZLBNCHG001.dxf
    Total lines: ~90 (vs poc-translator's ~920 positioned-span output for same letter) }}
<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <title>{{subject}}</title>
  <link rel="stylesheet" href="../styles/brand.css" />
  <link rel="stylesheet" href="../styles/typography.css" />
  <link rel="stylesheet" href="../styles/layout.css" />
  <link rel="stylesheet" href="../styles/letter-header.css" />
  <link rel="stylesheet" href="../styles/letter-address.css">
  <link rel="stylesheet" href="../styles/pos-zlbnchg.css" />
</head>
<body>
  <article class="page">
    {{> page-header}}

    <p class="letter-date">{{printDate}}</p>

    {{> address-with-barcode}}

    <h1 class="text-subject">{{subject}}</h1>

    <p>เรียน {{recipient.title}} {{recipient.name}}</p>

    <p class="body-para">
      ขอขอบคุณเป็นอย่างยิ่งที่มอบความไว้วางใจให้เอฟดับบลิวดีเป็นผู้ดูแลและรักษาผลประโยชน์ของคุณ
      ขอเรียนให้ทราบว่าเอฟดับบลิวดี ได้ดำเนินการเปลี่ยนแปลงข้อมูลกรมธรรม์เรียบร้อยแล้ว
    </p>

    <section class="policy-details">
      <h2 class="text-heading">รายละเอียดการเปลี่ยนแปลงข้อมูลกรมธรรม์</h2>
      <dl class="details">
        <dt>กรมธรรม์เลขที่</dt>       <dd>{{policy.number}}</dd>
        <dt>แบบประกันภัย</dt>          <dd>{{policy.planName}}</dd>
        <dt>ผู้เอาประกันภัย</dt>       <dd>{{policy.insured.title}} {{policy.insured.name}}</dd>
      </dl>
    </section>

    <p class="body-para">
      โดยหนังสือฉบับนี้ จะแนบติดและถือเป็นบันทึกสลักหลังเพิ่มเติม ซึ่งเป็นส่วนหนึ่งของกรมธรรม์ประกันภัย
      เป็นที่เข้าใจและตกลงกันว่า
    </p>

    <section class="change-details">
      <p>เปลี่ยนแปลง{{#eq change.type "beneficiary"}}ผู้รับผลประโยชน์{{/eq}}เป็น</p>
      <ul class="plain">
        {{#each change.beneficiaries}}
        <li>
          <span>{{this.title}} {{this.name}}</span>
          <span>อัตราส่วนร้อยละ {{formatPercent this.percentage}}</span>
        </li>
        {{/each}}
      </ul>
      <p>ตั้งแต่วันที่ {{change.effectiveDate}}</p>
    </section>

    <p class="body-para">
      เอฟดับบลิวดีได้อนุมัติและออกบันทึกสลักหลังฉบับนี้ไว้เป็นหลักฐาน ณ วันที่ {{approvalDate}}
    </p>

    {{> signature-block}}

    <p class="contact-info text-small">
      สามารถสอบถามรายละเอียดเพิ่มเติม ได้ที่ศูนย์บริการลูกค้าเอฟดับบลิวดี โทร. {{contact.phoneNumber}}
      เราพร้อมดูแลคุณทุกวัน เวลาทำการ {{contact.hours}}
      หรือสอบถามเจ้าหน้าที่ {{contact.aiChannelName}} ได้ตลอด 24 ชั่วโมง
      หรือจัดการกรมธรรม์ออนไลน์ด้วยตัวเองได้ที่แอปพลิเคชัน {{contact.appName}}
    </p>

    {{> page-footer}}
  </article>
</body>
</html>
